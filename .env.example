# Copy this file to .env and fill in real values. Never commit .env itself.

# ── Database (Postgres with PostGIS + pgvector extensions enabled) ─────────
# Supabase, Neon, or self-managed Postgres all work as long as both
# extensions are enabled: CREATE EXTENSION postgis; CREATE EXTENSION vector;
# (run these BEFORE `npx prisma migrate deploy`; the migrations add the columns,
# indexes and constraints).
DATABASE_URL=
# If connecting to Supabase: src/lib/prisma.ts verifies the DB server's TLS
# certificate against Supabase's own CA root, which isn't in Node's default
# trust store. Download it from Dashboard > Project Settings > Database >
# SSL Configuration and save it as certs/supabase-ca.crt (repo-relative).
# Without it the app uses Node's default trust store (fine for Neon and most
# managed providers); for a Supabase host it throws on startup in production.

# ── Auth ─────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
# The app throws on startup if this is unset — there is no insecure fallback.
NEXTAUTH_SECRET=
# Public URL of the deployed app (e.g. https://findmine.example.com)
NEXTAUTH_URL=

# ── Demo/seed-account login ──────────────────────────────────────────────
# Gates the "Quick Sign-In (Testing)" buttons and the matching server-side
# bypass in src/lib/auth.ts, which log straight into the two seeded demo
# accounts (see README) without touching Firebase. Defaults to disabled so a
# fresh clone/fork doesn't inherit a live seed-account login path by
# accident. The live findmine.onrender.com deployment sets both to "true"
# deliberately, since those accounts are non-sensitive demo data and their
# credentials are already published in the README for reviewers.
ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ── Firebase (client-side auth: Google/email sign-in) ────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Image uploads ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional hardening (app runs safely without these) ─
# Email is only used for relay-message alerts, and sign-in does not depend on
# it (Google only). Without a provider, emails are logged to the console.
# Set SMTP_* to send through any SMTP mailbox - note many hosts (including
# Render's free tier) block ports 25/465/587, so use a provider that accepts
# port 2525 (e.g. Brevo) there. Otherwise set RESEND_API_KEY with EMAIL_FROM on
# a verified Resend domain.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Runtime ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
