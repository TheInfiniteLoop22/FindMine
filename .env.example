# Copy this file to .env and fill in real values. Never commit .env itself.

# ── Database (Postgres with PostGIS + pgvector extensions enabled) ─────────
# Supabase, Neon, or self-managed Postgres all work as long as both
# extensions are installed (see scripts/setup-postgis.ts, scripts/setup-pgvector.ts).
DATABASE_URL=
# If connecting to Supabase: src/lib/prisma.ts verifies the DB server's TLS
# certificate against Supabase's own CA root, which isn't in Node's default
# trust store. Download it from Dashboard > Project Settings > Database >
# SSL Configuration and save it as certs/supabase-ca.crt (repo-relative).
# Without it: falls back to an unverified connection in development, throws
# on startup in production.

# ── Auth ─────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
# The app throws on startup if this is unset — there is no insecure fallback.
NEXTAUTH_SECRET=
# Public URL of the deployed app (e.g. https://findmine.example.com)
NEXTAUTH_URL=

# ── Demo/seed-account login ───────────────────────────────────────────────
# Gates the "Quick Sign-In (Testing)" buttons and the matching server-side
# bypass in src/lib/auth.ts, which log straight into the two seeded demo
# accounts (see README) without touching Firebase. Defaults to disabled so a
# fresh clone/fork doesn't inherit a live seed-account login path by
# accident. The live findmine.onrender.com deployment sets both to "true"
# deliberately, since those accounts are non-sensitive demo data and their
# credentials are already published in the README for reviewers.
ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ── Firebase (client-side auth: Google/email sign-in) ────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Image uploads ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (BullMQ embedding queue) ───────────────────────────────────────
# Optional. Without it, embeddings run inline via the direct runner.
REDIS_URL=
# Set to "true" only once a supervised, always-on process runs
# `scripts/run-worker.ts` — otherwise queued jobs will never be consumed.
ENABLE_BULLMQ_WORKER=false

# ── Optional hardening (app runs safely without these) ─
# hCaptcha secret — until set, CAPTCHA is never presented or required.
HCAPTCHA_SECRET=
# Resend API key — until set, transactional emails (relay messages) log to
# console instead of sending. Password reset uses Firebase's own email
# flow for real accounts and a token-based flow for seed accounts either way.
RESEND_API_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
