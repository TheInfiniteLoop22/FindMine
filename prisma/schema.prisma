datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  displayName     String
  photoUrl        String?
  reputationScore Int               @default(0)
  createdAt       DateTime          @default(now())

  // Hardened Auth Verification schema extensions
  emailVerified   DateTime?
  isSeedAccount   Boolean           @default(false)
  bio             String?

  accounts        Account[]
  claimsFiled     Claim[]           @relation("ClaimsFiled")
  claimsOwned     Claim[]           @relation("ClaimsOwned")
  posts           Post[]
  reputationEvents ReputationEvent[]
  sessions        Session[]
  registeredItems RegisteredItem[]
  notifications   Notification[]

  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  messagesSent    Message[]      @relation("MessageSender")
}


model ReputationEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  points     Int
  refPostId  String?
  refClaimId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SecureToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  type       String   // 'EMAIL_VERIFICATION' or 'PASSWORD_RESET'
  email      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tokenHash])
}


model Post {
  id              String                    @id @default(cuid())
  type            PostType
  status          PostStatus                @default(OPEN)
  title           String
  description     String
  category        String
  photoUrl        String?
  createdAt       DateTime                  @default(now())
  userId          String
  lat             Float?
  lng             Float?
  locationText    String?                   @default("Location specified")
  contactPhone    String?
  privateDetail   String?
  eventDateTime   DateTime?
  itemStatus      String?
  depositLocationText String?
  depositLat      Float?
  depositLng      Float?
  location        Unsupported("geography")?
  imageEmbedding  Unsupported("vector")?
  textEmbedding   Unsupported("vector")?
  embeddingStatus String                    @default("pending")
  claims          Claim[]
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  images          PostImage[]
  matchesTarget   PostMatch[]               @relation("MatchTarget")
  matchesSource   PostMatch[]               @relation("MatchSource")
  conversationLinks ConversationPostLink[]
}

model PostImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false)
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Claim {
  id           String        @id @default(cuid())
  status       ClaimStatus   @default(PENDING)
  answerText   String?
  proofImageUrl  String?
  itemStatus     String?
  depositLocation String?
  depositLat     Float?
  depositLng     Float?
  foundAt        DateTime?
  privateDetailAnswer String?
  createdAt    DateTime      @default(now())
  reviewedAt   DateTime?
  postId       String
  claimantId   String
  ownerId      String
  claimant     User          @relation("ClaimsFiled", fields: [claimantId], references: [id], onDelete: Cascade)
  owner        User          @relation("ClaimsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  conversationLink ConversationPostLink?

  @@index([postId])
  @@index([ownerId, status])
  @@index([claimantId])
}

model PostMatch {
  id            String   @id @default(cuid())
  postId        String
  matchedPostId String
  score         Float
  distanceKm    Float?
  createdAt     DateTime @default(now())
  matchedPost   Post     @relation("MatchTarget", fields: [matchedPostId], references: [id], onDelete: Cascade)
  post          Post     @relation("MatchSource", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, matchedPostId])
  @@index([postId, score])
}

model Conversation {
  id         String   @id @default(cuid())
  userAId    String
  userBId    String
  createdAt  DateTime @default(now())

  messages   Message[]
  links      ConversationPostLink[]

  userA      User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB      User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model ConversationPostLink {
  id             String @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  postId         String
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  claimId        String       @unique
  claim          Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  body           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  readAt         DateTime?

  sender         User?    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model RegisteredItem {
  id           String      @id @default(cuid())
  nickname     String
  category     String?
  photoUrl     String?
  contactMode  ContactMode @default(RELAY_ONLY)
  status       ItemStatus  @default(ACTIVE)
  publicToken  String      @unique @default(cuid())
  createdAt    DateTime    @default(now())
  lostAt       DateTime?

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  scans        ScanEvent[]
  messages     RelayMessage[]

  email        String?

  @@index([userId])
}

model ScanEvent {
  id               String   @id @default(cuid())
  registeredItemId String
  item             RegisteredItem @relation(fields: [registeredItemId], references: [id], onDelete: Cascade)
  scannedAt        DateTime @default(now())
  roughArea        String?

  @@index([registeredItemId, scannedAt])
}

model RelayMessage {
  id               String   @id @default(cuid())
  registeredItemId String
  item             RegisteredItem @relation(fields: [registeredItemId], references: [id], onDelete: Cascade)
  message          String
  finderContact    String?
  sentAt           DateTime  @default(now())
  deliveredVia     String

  @@index([registeredItemId, sentAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'QR_SCAN' | 'QR_RELAY_MESSAGE' — free-text so new types don't need a migration
  title     String
  body      String
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum PostType {
  LOST
  FOUND
}

enum PostStatus {
  OPEN
  MATCHED
  CLOSED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactMode {
  SHOW_PHONE
  SHOW_EMAIL
  RELAY_ONLY
}

enum ItemStatus {
  ACTIVE
  LOST_REPORTED
}
